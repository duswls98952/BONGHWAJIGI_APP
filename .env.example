EXPO_PUBLIC_API_MODE=mock
# live 모드는 설치 계정 등록을 허용한 사설 simulation 서버에 연결합니다.
EXPO_PUBLIC_API_BASE_URL=
# 네이버 Mobile Dynamic Map Client ID는 공개 식별자입니다. Secret은 넣지 않습니다.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
# 구형0.1 틀의 플래그. 현재0.2 MVP는 검증된 경로 도형 미제공입니다.
EXPO_PUBLIC_ROUTE_2D_CONTRACT_ENABLED=false
# 사용자 동의 UI + development build + 실제 단말 검증 후 사용합니다.
EXPO_PUBLIC_ENABLE_BACKGROUND_LOCATION=false
# EAS 프로젝트 생성 후 발급받은 projectId. 자동으로 프로젝트를 만들지 않습니다.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android FCM 설정 파일 경로. 파일은 Git에서 제외됩니다.
GOOGLE_SERVICES_JSON=

# USB 검증 전용 HTTP 허용. HTTPS 배포는 false.
EXPO_PUBLIC_ALLOW_LOOPBACK_HTTP=false
# 내부 합성 시연 빌드에서만 명시한 시나리오 위치 버튼을 표시합니다.
EXPO_PUBLIC_DEMO_LATITUDE=
EXPO_PUBLIC_DEMO_LONGITUDE=
