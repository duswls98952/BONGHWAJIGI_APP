EXPO_PUBLIC_API_MODE=mock
# live 모드는 인증 제공자 구현과 접근 가능한 HTTPS 서버가 필요합니다.
EXPO_PUBLIC_API_BASE_URL=
# 네이버 Mobile Dynamic Map Client ID는 공개 식별자입니다. Secret은 넣지 않습니다.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
# 서버와 2D 경로 capability 합의 후 true. 기존 route_3d와 별개입니다.
EXPO_PUBLIC_ROUTE_2D_CONTRACT_ENABLED=false
# 사용자 동의 UI + development build + 실제 단말 검증 후 사용합니다.
EXPO_PUBLIC_ENABLE_BACKGROUND_LOCATION=false
# EAS 프로젝트 생성 후 발급받은 projectId. 자동으로 프로젝트를 만들지 않습니다.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android FCM 설정 파일 경로. 파일은 Git에서 제외됩니다.
GOOGLE_SERVICES_JSON=
