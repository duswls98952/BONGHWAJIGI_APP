{
  "name": "bonghwajigi-app",
  "version": "0.2.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@mj-studio/react-native-naver-map": "2.9.1",
    "@tanstack/react-query": "5.105.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sms": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "api:generate": "node tools/api-generator/node_modules/openapi-typescript/bin/cli.js docs/api/upstream-openapi.yaml -o src/api/generated.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run check:docs",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web",
    "api:setup": "npm ci --prefix tools/api-generator",
    "start:go": "expo start --go",
    "api:generate:mvp": "node tools/api-generator/node_modules/openapi-typescript/bin/cli.js docs/api/mvp-openapi.json -o src/api/mvp-generated.ts --default-non-nullable false"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
